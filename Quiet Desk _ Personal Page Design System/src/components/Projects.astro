---
const projects = [
  {
    name: 'this site',
    tag: 'home',
    blurb: 'always being slightly rewritten.',
    color: 'dusk',
  },
  {
    name: 'Asteroids pygame',
    tag: 'python',
    blurb: 'simple video game based on the classic asteroids.',
    color: 'mustard',
  },
  {
    name: 'AI agent',
    tag: 'python',
    blurb: 'gemini-like cli tool for all the fixes to your problems.',
    color: 'terracotta',
  },
];
---
<section class="side__section" id="building">
  <h3 class="side__title">things i'm building</h3>
  <ul class="projects">
    {projects.map((p) => (
      <li>
        <a href="#" class={`project__link project project--${p.color}`}>
          <div class="project__head">
            <span class="project__name">{p.name}</span>
            <span class="project__tag">{p.tag}</span>
          </div>
          <p class="project__blurb">{p.blurb}</p>
        </a>
      </li>
    ))}
  </ul>
</section>
